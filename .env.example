# foxleague-agent environment. Locally: .env (mode 600, gitignored). On the server: /etc/foxleague-agent/env
# (mode 600, owned by the service user), loaded by systemd.

# The recovery words, created by `npm run cli -- setup`; never type them in, never commit them.
AGENT_MNEMONIC=

# Strategist (platform.claude.com -> API keys; set a monthly spend limit there).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_MODEL_EFFORT=medium

# Telegram: token from @BotFather, the owner's chat id. Only that chat is answered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The morning summary on Telegram: its time zone (default this computer's) and hour (default 9).
# TELEGRAM_SUMMARY_TZ=Europe/Bucharest
# TELEGRAM_SUMMARY_HOUR=9

# How many agents this install starts with (agents 1..N, from the recovery words). Every agent follows the one
# platform mode: a new install starts in dry run, an agent added later follows the current mode.
AGENT_COUNT=1
AGENT_MAX_AGENTS=5

# The server's one-time permission to sign. Live also needs the platform switched to live (web UI header,
# Telegram /mode live confirm or `agentctl.sh mode live`); until then every agent stays in dry run.
# AGENT_LIVE_ENABLED=1

# Set on the server: refuses local-only commands (PEM export).
# AGENT_IS_SERVER=1

# MultiversX. With your own observing squad, point this at it; otherwise the public gateway.
MVX_GATEWAY_URL=https://gateway.multiversx.com
MVX_GATEWAY_RPS=5
MVX_API_URL=https://api.multiversx.com
FOXLEAGUE_URL=https://foxleague.ai
AGENT_DATA_DIR=data

# Dashboard (written by the installer or `npm run cli -- set-web-password`).
# WEB_UI_PORT=8870
# The address the dashboard listens on (default 127.0.0.1, reached through nginx or an SSH tunnel). Only a
# container that publishes the port on the host's loopback needs 0.0.0.0 inside its own network.
# WEB_UI_HOST=127.0.0.1
# WEB_UI_USER=
# WEB_UI_PASSWORD_HASH=
# WEB_UI_SECRET=
# WEB_UI_INSECURE_COOKIE=1   only for plain http on this computer; never behind a public address
# WEB_UI_TRUST_PROXY=1       only behind your own nginx (it sends the client IP in X-Real-IP), and there set it:
#                            without it every visitor comes from nginx's address and shares one login lockout

# Where PEM files for your agents are written on a local install.
# AGENT_PEM_DIR=/path/to/foxleague-agent/pem

# CEX top-up key (Binance for now): EGLD top-ups you approve on Telegram with /topup <code>.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Whose Binance account it is, for the EU Travel Rule form Binance asks with each withdrawal: individual or corporate.
# BINANCE_ACCOUNT_TYPE=individual

# Request rates (per second) for the public MultiversX API and FoxLeague.
# MVX_API_RPS=1.8
# FOXLEAGUE_RPS=5
