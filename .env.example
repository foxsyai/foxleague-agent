# foxleague-agent environment. Locally: .env (mode 600, gitignored). On the server: /etc/foxleague-agent/env
# (mode 600, owned by the service user), loaded by systemd.

# The recovery words, created by `npm run cli -- setup`; never type them in, never commit them.
AGENT_MNEMONIC=

# Strategist (console.anthropic.com -> API Keys; set a monthly spend limit there).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_MODEL_EFFORT=medium

# Telegram: token from @BotFather, the owner's chat id. Only that chat is answered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How many agents this install starts with (agents 1..N, from the recovery words). New agents start in dry run.
AGENT_COUNT=1
AGENT_MAX_AGENTS=5

# The server's one-time permission to sign. Live also needs the platform switched to live (web UI header,
# Telegram /mode live or `agentctl.sh mode live`); until then every agent stays in dry run.
# AGENT_LIVE_ENABLED=1

# Set on the server: refuses local-only commands (PEM export).
# AGENT_IS_SERVER=1

# MultiversX. With your own observing squad, point this at it; otherwise the public gateway.
MVX_GATEWAY_URL=https://gateway.multiversx.com
MVX_GATEWAY_RPS=5
MVX_API_URL=https://api.multiversx.com
FOXLEAGUE_URL=https://foxleague.ai
AGENT_DATA_DIR=data
